# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
# Every variable below is optional — Lyra runs a local-only analysis with none of them set.

# --- AI providers (used by the discovery analyzer, src/discovery/analyzer.py) ---
# Set one of these to enable AI-assisted tool analysis. If neither is set, the
# analyzer falls back to the local, non-AI heuristic provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Lyra Registry (used by src/discovery/submitter.py) ---
# Endpoint that approved tools are submitted to, and its API key.
LYRA_REGISTRY_URL=http://localhost:3002/api
LYRA_REGISTRY_API_KEY=

# --- API server authentication ---
# Shared secret required by clients of the Lyra API server. Leave empty to disable auth.
API_KEY=

# --- Source hosts (used by the git/repository collectors) ---
# Personal access tokens for private repositories and higher rate limits.
GITHUB_TOKEN=

# --- Postgres (read by docker-compose.yml for the "postgres" service) ---
# Defaults to "lyra_secret" if unset. Change it for anything but local use.
POSTGRES_PASSWORD=
